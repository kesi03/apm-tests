FROM node:20-alpine AS build
WORKDIR /app
ARG VITE_ELASTIC_APM_SERVICE_NAME=react-app
ARG VITE_ELASTIC_APM_SERVICE_VERSION=1.0.0
ARG VITE_ELASTIC_APM_ENVIRONMENT=development
ENV VITE_ELASTIC_APM_SERVICE_NAME=$VITE_ELASTIC_APM_SERVICE_NAME \
    VITE_ELASTIC_APM_SERVICE_VERSION=$VITE_ELASTIC_APM_SERVICE_VERSION \
    VITE_ELASTIC_APM_ENVIRONMENT=$VITE_ELASTIC_APM_ENVIRONMENT
COPY package.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
